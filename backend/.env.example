# AWS region where both Comprehend and your Bedrock model are available
AWS_REGION=eu-west-2

# Bedrock model ID (or inference profile ID, e.g. eu.anthropic.claude-...)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Where the React dev server runs (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# AWS credentials: use `aws configure`, an AWS profile, or set these
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
